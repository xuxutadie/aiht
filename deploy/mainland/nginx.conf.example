# 仅为备案完成、证书已申请后的正式站点样板；不要在内部验收阶段直接启用。
# 请替换证书路径并由现有宝塔 Nginx 执行配置检查；不要覆盖其他站点配置。
server {
    listen 80;
    server_name xqd-ai.cn;
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/xqd-ai-cn-acme;
    }
    location / {
        return 301 https://xqd-ai.cn$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name xqd-ai.cn;
    ssl_certificate /www/server/panel/vhost/cert/xqd-ai.cn/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/xqd-ai.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 60s;
    gzip on;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_vary on;

    # 网页和私有图片均经过应用；绝不能把 /var/lib 数据目录配置为 root 或 alias。
    location / {
        proxy_pass http://127.0.0.1:8321;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 30s;
        proxy_buffering on;
        proxy_request_buffering on;
    }
}

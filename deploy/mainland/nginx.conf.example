# 仅为备案完成、证书已申请后的正式站点样板；不要在内部验收阶段直接启用。
# 将所有 domain.example 替换为自己的域名；替换证书路径和 ACME 验证目录。
# 交给现有 Nginx 执行配置检查通过才启用；不要覆盖其他站点配置。
server {
    listen 80;
    server_name domain.example;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/domain.example-acme;
    }
    location / {
        return 301 https://domain.example$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name domain.example;
    ssl_certificate /REPLACE_WITH_YOUR_CERT_DIR/fullchain.pem;
    ssl_certificate_key /REPLACE_WITH_YOUR_CERT_DIR/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 60s;
    gzip on;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_vary on;

    # 网页和私有图片均经过应用；绝不能把 /var/lib 数据目录配置为 root 或 alias。
    location / {
        proxy_pass http://127.0.0.1:8321;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 30s;
        proxy_buffering on;
        proxy_request_buffering on;
    }
}

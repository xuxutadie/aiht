{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ht",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "npm run build",
    "watch_dir": ["../public", "build-frontend.mjs"]
  },
  "routes": [],
  "durable_objects": {
    "bindings": [
      { "name": "RUNTIME_SERVICES", "class_name": "AihtRuntimeServices" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AihtRuntimeServices"] }
  ],
  "assets": {
    "directory": ".wrangler/frontend-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiht-creation-db",
      "database_id": "465ffd34-b9c4-47d2-8218-fe71895f4b71"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "GENERATION_QUEUE", "queue": "aiht-generation" }
    ],
    "consumers": [
      {
        "queue": "aiht-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 0
      }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
